<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:clipChildren="false">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_nav"
        android:elevation="8dp"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/nav_sky"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="@string/tab_sky"
            android:scaleType="center"
            android:src="@drawable/ic_nav_sky"
            app:tint="@color/nav_item" />

        <ImageButton
            android:id="@+id/nav_catalog"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="@string/tab_catalog"
            android:scaleType="center"
            android:src="@drawable/ic_nav_catalog"
            app:tint="@color/nav_item" />

        <ImageButton
            android:id="@+id/nav_atlas"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="@string/tab_atlas"
            android:scaleType="center"
            android:src="@drawable/ic_nav_atlas"
            app:tint="@color/nav_item" />

        <ImageButton
            android:id="@+id/nav_profile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="@string/tab_profile"
            android:scaleType="center"
            android:src="@drawable/ic_nav_profile"
            app:tint="@color/nav_item" />
    </LinearLayout>
</FrameLayout>
